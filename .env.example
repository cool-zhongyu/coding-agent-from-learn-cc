LLM_MODEL_ID=your-model-id
LLM_API_KEY=
# LLM_BASE_URL=https://your-anthropic-compatible-provider

# strict / trusted_workspace / unattended
AGENT_PERMISSION_MODE=strict
# Enable only if the provider supports Anthropic cache_control.
AGENT_PROMPT_CACHE=0

# Optional: both endpoints and an embedding model are required.
# Configure the complete embeddings endpoint URL.
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional: Langfuse tracing and online evaluation.
# Create a project at https://cloud.langfuse.com (or use self-hosted Langfuse).
# Do not commit real keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=1
LANGFUSE_ENVIRONMENT=development
# Optional release/version label shown in Langfuse.
# LANGFUSE_RELEASE=local
# Optional evaluator model override; omit to use the project's default LLM connection.
# LANGFUSE_EVAL_PROVIDER=anthropic
# LANGFUSE_EVAL_MODEL=claude-sonnet-4-5
